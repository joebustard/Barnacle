<UserControl
    x:Class="Barnacle.Views.NewProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ViewModels="clr-namespace:Barnacle.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Barnacle.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <ViewModels:NewProjectViewModel />
    </UserControl.DataContext>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Barnacle;component/Images/Barnicle.png" />
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="30" />
            <RowDefinition Height="45" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Grid.RowSpan="1"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Background="White"
            BorderThickness="4"
            Style="{StaticResource ControlBorder}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="18">
                    Project Name
                </Label>

                <TextBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>
        <TabControl
            Grid.Row="3"
            Grid.RowSpan="5"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            BorderBrush="green"
            BorderThickness="4">

            <TabItem
                Background="AliceBlue"
                BorderBrush="green"
                BorderThickness="4"
                FontSize="20"
                Header="By Template">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="50" />
                        <RowDefinition />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Background="White"
                        BorderThickness="4"
                        Style="{StaticResource ControlBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="18">
                                Template
                            </Label>

                            <ComboBox
                                x:Name="TemplateBox"
                                Grid.Column="1"
                                Grid.ColumnSpan="1"
                                ItemsSource="{Binding TemplateNames}"
                                SelectedItem="{Binding SelectedTemplate}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        Background="White"
                        BorderThickness="4"
                        Style="{StaticResource ControlBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18">
                                Description
                            </Label>

                            <TextBox
                                x:Name="DescriptionBox"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                AcceptsReturn="True"
                                FontSize="18"
                                IsReadOnly="True"
                                Text="{Binding SelectedDescription}"
                                TextChanged="DescriptionBox_TextChanged"
                                VerticalScrollBarVisibility="Visible" />
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="1"
                            Command="{Binding BackCommand}"
                            Content="Back">
                            <Button.Style>
                                <Style BasedOn="{StaticResource LargeButton}" TargetType="Button">

                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Margin" Value="4,4,4,4" />
                                            <Setter Property="FontSize" Value="20" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Command="{Binding CreateCommand}"
                            CommandParameter="ByTemplate"
                            Content="Create"
                            IsDefault="True"
                            IsEnabled="{Binding OKEnabled}">

                            <Button.Style>
                                <Style BasedOn="{StaticResource LargeButton}" TargetType="Button">

                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Margin" Value="4,4,4,4" />
                                            <Setter Property="FontSize" Value="20" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem
                Background="AliceBlue"
                BorderBrush="green"
                BorderThickness="4"
                FontSize="20"
                Header="Design">
                <ScrollViewer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Models" />
                        <TextBox
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            BorderThickness="2"
                            Text="{Binding ModelList}" />
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="Add Subparts" IsChecked="{Binding GenerateSubparts}" ToolTip="Add a subpart folder with a matching subpart file for every part and a matching skeleton make script" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Assemblies" />
                        <TextBox
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Grid.Column="4"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            BorderThickness="2"
                            Text="{Binding AssemblyList}" />

                        <Label
                            Grid.Row="4"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Extra Scripts" />
                        <TextBox
                            Grid.Row="5"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            BorderThickness="2"
                            Text="{Binding ScriptList}" />

                        <Label
                            Grid.Row="4"
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Script Includes" />
                        <TextBox
                            Grid.Row="5"
                            Grid.RowSpan="3"
                            Grid.Column="4"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            BorderThickness="2"
                            Text="{Binding ScriptIncludeList}" />

                        <StackPanel
                            Grid.Row="8"
                            Grid.Column="0"
                            Orientation="Horizontal">
                            <Label
                                Margin="4,0,4,0"
                                VerticalAlignment="Center"
                                Content="No. Kits" />
                            <TextBox
                                Width="50"
                                Margin="0,2,0,2"
                                Text="{Binding NumberOfKits}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="8"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <!--
                            <CheckBox Content="Quick Assembler" VerticalAlignment="Center" IsChecked="{Binding GenerateQuickAssembler}" />
                            -->
                        </StackPanel>
                        <Grid
                            Grid.Row="9"
                            Grid.Column="0"
                            Grid.ColumnSpan="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="1"
                                Command="{Binding BackCommand}"
                                Content="Back">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource LargeButton}" TargetType="Button">

                                        <Style.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Margin" Value="4,4,4,4" />
                                                <Setter Property="FontSize" Value="20" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Command="{Binding CreateCommand}"
                                CommandParameter="Design"
                                Content="Create"
                                IsDefault="True"
                                IsEnabled="{Binding OKEnabled}">

                                <Button.Style>
                                    <Style BasedOn="{StaticResource LargeButton}" TargetType="Button">

                                        <Style.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Margin" Value="4,4,4,4" />
                                                <Setter Property="FontSize" Value="20" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>